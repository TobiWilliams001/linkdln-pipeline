# Local Postgres (docker-compose)
DATABASE_URL="postgresql://linkedin_pipeline:linkedin_pipeline@localhost:5432/linkedin_pipeline?schema=public"

# Auth.js
AUTH_SECRET=""

# Email of the one admin user seeded via `npx prisma db seed`
ADMIN_EMAIL=""

# OpenRouter (content generation, routes to Claude)
OPENROUTER_API_KEY=""

# OpenAI (Whisper transcription only)
OPENAI_API_KEY=""

# Resend (magic-link auth emails, weekly reminders)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Vercel Blob (voice note uploads)
BLOB_READ_WRITE_TOKEN=""

# Secures /api/cron/weekly-reminder - Vercel sends this as a Bearer token
# automatically for routes declared in vercel.json's "crons" list
CRON_SECRET=""

# Base URL used in reminder email links (e.g. https://yourapp.vercel.app)
NEXT_PUBLIC_APP_URL=""
