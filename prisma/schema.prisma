// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum CheckInFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ContentType {
  INSIGHT
  STORY
  PROCESS
  OPINION
  RESULT
  OBSERVATION
}

model Client {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  voiceProfile     String?
  coreBelief       String?
  icpPain          String?
  originStory      String?
  clientResults    Json?
  strongOpinions   Json?
  contentExamples  String[]
  postingCadence   Int              @default(4)
  checkInFrequency CheckInFrequency @default(WEEKLY)
  createdAt        DateTime         @default(now())

  users        User[]
  weeklyInputs WeeklyInput[]
  contentPosts ContentPost[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(CLIENT)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WeeklyInput {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  weekNumber      Int
  year            Int
  whatHappened    String?
  clientSituation String?
  questionAsked   String?
  industryObs     String?
  voiceNoteUrl    String?
  submittedAt     DateTime @default(now())

  contentPosts ContentPost[]

  @@unique([clientId, weekNumber, year])
}

model ContentPost {
  id             String      @id @default(cuid())
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  weeklyInputId  String
  weeklyInput    WeeklyInput @relation(fields: [weeklyInputId], references: [id])
  weekNumber     Int
  year           Int
  contentType    ContentType
  generatedDraft String
  editedDraft    String?
  approved       Boolean     @default(false)
  posted         Boolean     @default(false)
  postDate       DateTime?
  linkedinUrl    String?
  impressions    Int?
  likes          Int?
  comments       Int?
  createdAt      DateTime    @default(now())
}
